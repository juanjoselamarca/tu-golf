{
  "name": "golfersplus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src",
    "lint:strict": "next lint --dir src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file=.env.local node_modules/vitest/vitest.mjs run src/__tests__/integration",
    "test:integration:ci": "vitest run src/__tests__/integration --exclude '**/import-pipeline.test.ts' --retry=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=mobile-chromium e2e/smoke.spec.ts e2e/smoke-public-pages.spec.ts",
    "test:e2e:auth": "playwright test --project=mobile-chromium-auth",
    "test:e2e:ronda": "playwright test --project=mobile-chromium-auth e2e/ronda-flow.spec.ts",
    "test:e2e:setup-user": "node --env-file=.env.local scripts/setup-e2e-user.mjs",
    "audit": "tsx scripts/run-audit.ts",
    "audit:all": "tsx scripts/run-audit.ts all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next": "^15.5.25",
    "pdf-parse": "^2.4.5",
    "posthog-js": "^1.364.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^29.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
