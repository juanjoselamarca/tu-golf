#!/bin/sh
# Blocks the push if typecheck, tests, build or the schema check fail (CLAUDE.md, rule 1); they live in
# scripts/verify.mjs, which skips them when `npm run verify` already passed on exactly the pushed tree.
# Enabled by `npm install` (prepare sets core.hooksPath). --no-verify needs Juanjo's approval.
exec node scripts/verify.mjs --pre-push
