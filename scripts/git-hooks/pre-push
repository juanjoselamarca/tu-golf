#!/bin/sh
# Blocks the push if typecheck, tests, build or the schema check fail (CLAUDE.md, rule 1).
# Enabled by `npm install` (prepare sets core.hooksPath). --no-verify needs Juanjo's approval.
set -e

echo "pre-push: tsc"
npx tsc --noEmit

echo "pre-push: tests"
npm run test

echo "pre-push: build"
rm -rf .next
npm run build

echo "pre-push: schema"
# Exit 2 = no credentials or no network: warns, does not block.
node --env-file-if-exists=.env.local scripts/verify-db-schema.mjs || [ $? -eq 2 ]
