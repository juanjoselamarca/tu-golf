# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[proyecto].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ─── IA ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Admin (fallback si no se usa columna role en profiles) ───────────────────
ADMIN_EMAILS=

# ─── Integraciones ────────────────────────────────────────────────────────────
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# ─── Push Notifications (Web Push + VAPID) ───────────────────────────────────
# Generar ambas claves (una sola vez) con:
#   npx web-push generate-vapid-keys
# La public va en cliente (prefijo NEXT_PUBLIC_). La private y el contact
# email SOLO en server (no prefijo NEXT_PUBLIC_). Sin estas keys, push falla
# al cargar src/lib/push-notifications.ts en producción.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=admin@golfersplus.com

# ─── Base de pruebas (E2E, integración y seed; ver docs/claude/base-de-pruebas.md) ─
# scripts/test-db/con-base-de-pruebas.mjs y e2e-local.mjs las mapean a las variables de arriba.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_E2E_USER_EMAIL=e2e-test@golfersplus-test.local
TEST_E2E_USER_PASSWORD=...

# ─── Usuario E2E de prod (sólo los canarios de prod, que corren en CI: prod-canarios.yml) ─
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Clave de las cuentas que crean los seeds (src/scripts/seed-*.ts). Opcional: vacía o ausente = una al azar que no se guarda (16 caracteres a 72 bytes).
SEED_USERS_PASSWORD=
